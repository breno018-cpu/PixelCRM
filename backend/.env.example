# PixelCRM Backend - Configuração de Ambiente para Produção

# Porta de execução do servidor HTTP
PORT=5000

# URL do banco de dados SQLite (usar caminho relativo para dev.db)
DATABASE_URL="file:./dev.db"

# Chave secreta para assinatura dos tokens JWT (OBRIGATÓRIO alterar em produção)
JWT_SECRET="shineray-crm-super-secret-jwt-key-2025-pixel-loom-secure"

# Origens permitidas para requisições CORS (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:80"

# Chaves de API para Inteligência Artificial (Opcional - também configurável via painel web)
# GEMINI_API_KEY="AIzaSy..."
# OPENAI_API_KEY="sk-..."
