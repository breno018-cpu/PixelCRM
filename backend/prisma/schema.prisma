datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  chats     Chat[]
}

model Chat {
  id              String    @id // JID do WhatsApp (ex: 5511999999999@s.whatsapp.net)
  name            String?   // Nome salvo ou editado
  pushName        String?   // Nome do perfil do WhatsApp do cliente
  phone           String    // Telefone formatado
  unreadCount     Int       @default(0)
  lastMessageText String?
  lastMessageTime DateTime?
  funnelStage     String    @default("LEAD") // LEAD, NEGOTIATION, PROPOSAL, CLOSED
  tags            String    @default("")     // Tags separadas por vírgula (Ex: "VIP,Aguardando Pgto")
  notes           String    @default("")     // Notas de CRM internas
  avatarUrl       String?   // URL do avatar do contato no WhatsApp
  isArchived      Boolean   @default(false)  // Se a conversa está arquivada no WhatsApp
  
  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  assignedUserId  String?
  assignedUser    User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@index([storeId])
  @@index([assignedUserId])
}

model Message {
  id          String   @id // ID gerado pelo WhatsApp
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  fromMe      Boolean
  senderName  String?
  text        String
  type        String   @default("text") // text, audio, image, video, document
  mediaUrl    String?
  timestamp   DateTime
  status      String   @default("PENDING") // PENDING, SENT, DELIVERED, READ

  @@index([chatId])
  @@index([timestamp])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("OPERATOR") // ADMIN, MANAGER, OPERATOR
  isActive     Boolean   @default(true)
  
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  assignedChats Chat[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId])
}
